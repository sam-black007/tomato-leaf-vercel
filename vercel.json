{
  "buildCommand": "pip install -r requirements.txt",
  "outputDirectory": "static",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/analyze", "dest": "/api/index.py" },
    { "src": "/api/crosscheck", "dest": "/api/index.py" },
    { "src": "/health", "dest": "/api/index.py" }
  ]
}
